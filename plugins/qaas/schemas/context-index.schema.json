{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eldarush/QaaS-Plugin/schemas/context-index.schema.json",
  "title": "QaaS project context index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "generatedAt",
    "topics",
    "managedClaudeBlock",
    "contextDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "title", "purpose", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^qaas/(?!.*(?:^|[\\\\/])\\.\\.?(?:[\\\\/]|$))(?!\\.\\.?[\\\\/]).+\\.(?:md|json)$"
          },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "managedClaudeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMarker", "endMarker", "sha256"],
      "properties": {
        "startMarker": { "const": "<!-- QAAS:START -->" },
        "endMarker": { "const": "<!-- QAAS:END -->" },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "contextDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
